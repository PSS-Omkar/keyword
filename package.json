{
  "name": "keyword-generator",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Full-stack keyword generator application with React frontend and Express backend",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build": "npm run build --prefix client && npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "start": "npm run start --prefix server",
    "check": "npm run check --prefix client && npm run check --prefix server",
    "install:all": "npm install && npm install --prefix client && npm install --prefix server",
    "docker:build:client": "cd client && docker-compose build",
    "docker:build:server": "cd server && docker-compose build",
    "docker:up:client": "cd client && docker-compose up -d",
    "docker:up:server": "cd server && docker-compose up -d",
    "docker:down:client": "cd client && docker-compose down",
    "docker:down:server": "cd server && docker-compose down",
    "docker:logs:client": "cd client && docker-compose logs -f",
    "docker:logs:server": "cd server && docker-compose logs -f"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "20.16.11",
    "typescript": "^5.6.3",
    "vite": "^5.4.19"
  }
}
