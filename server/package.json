{
  "name": "keyword-generator-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API server for Keyword Generator platform",
  "main": "index.ts",
  "scripts": {
    "dev": "npx tsx index.ts",
    "start": "npx tsx index.ts",
    "build": "esbuild index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start:prod": "node dist/index.js",
    "check": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "docker:build": "docker build -t keyword-generator-backend .",
    "docker:run": "docker run -p 5000:5000 keyword-generator-backend",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:db:push": "docker-compose exec backend npm run db:push"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@types/express-fileupload": "^1.5.1",
    "@types/memoizee": "^0.4.12",
    "@types/node-fetch": "^2.6.13",
    "axios": "^1.11.0",
    "connect-pg-simple": "^10.0.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.1",
    "express": "^4.21.2",
    "express-fileupload": "^1.5.2",
    "express-session": "^1.18.2",
    "google-auth-library": "^10.3.0",
    "keyword-generator": "file:..",
    "memoizee": "^0.4.17",
    "memorystore": "^1.6.7",
    "node-fetch": "^3.3.2",
    "openid-client": "^6.6.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.12.0",
    "rest-express": "file:..",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "20.16.11",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.30.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.5",
    "typescript": "^5.6.3"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/keyword-generator.git",
    "directory": "server"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "postgresql",
    "drizzle",
    "keyword-generator",
    "backend",
    "api"
  ],
  "author": "Your Name",
  "license": "MIT"
}
