# Environment Variables Template
# Copy this file to .env and fill in your values

# Development/Production Mode
NODE_ENV=development

# Database Configuration
# For local development with Docker:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/keyword_generator
# For production with external PostgreSQL:
# DATABASE_URL=postgresql://username:password@host:port/database

# Google OAuth Configuration (Required for Google Keyword Planner)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Currency Configuration
USD_RATE=87.67

# Vite/Builder.io Configuration
VITE_PUBLIC_BUILDER_KEY=5f94e1ffba2a40a0be80cbadd7806726

# Application Configuration
PORT=5000
HOST=localhost
